#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define LANG_EN LC(LS(N1))
#define LANG_RU LC(LS(N2))

/ {
    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&macro_tap &kp LANG_RU &to 1>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <15>;
            tap-ms = <15>;
            bindings = <&macro_tap &kp LANG_EN &to 0>;
        };

        en_sym: en_sym {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <20>;
            tap-ms = <15>;
            bindings
                = <&macro_tap &kp LANG_EN>
                , <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                , <&macro_tap &kp LANG_RU>
                ;
        };
    };

    behaviors {
        mo_tog: behavior_mo_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        ru_symbols_override {
            if-layers = <1 3>;
            then-layer = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
&kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4      &kp N5                           &kp N6   &kp N7    &kp N8    &kp N9  &kp N0   &kp MINUS
&kp ESC   &kp Q  &kp W    &kp E    &kp R       &kp T                            &kp Y    &kp U     &kp I     &kp O   &kp P    &kp LBKT
&kp TAB   &kp A  &kp S    &kp D    &kp F       &kp G                            &kp H    &kp J     &kp K     &kp L   &kp SEMI &kp SQT
&kp LCTRL &kp Z  &kp X    &kp C    &kp V       &kp B     &kp C_MUTE  &kp C_PP   &kp N    &kp M     &kp COMMA &kp DOT &kp FSLH &kp RBKT
                 &mo_tog 5 5 &kp LALT &mo 2    &kp SPACE &kp RET     &kp BSPC   &kp LSHFT &mo 3    &kp LGUI  &to_ru
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp DOWN UP>;
        };

        ru_layer {
            display-name = "RU_State";
            bindings = <
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans &trans
              &trans &trans &trans &trans &trans    &trans &trans &trans &trans &to_en
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp DOWN UP>;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp F11 &kp F1    &kp F2    &kp F3    &kp F4    &kp F5                         &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F12
&trans  &kp DEL   &kp HOME  &kp UP    &kp END   &trans                         &kp PG_UP &kp LC(Y) &kp LC(A) &kp LC(F) &kp LC(S) &kp INS
&trans  &kp BSPC  &kp LEFT  &kp DOWN  &kp RIGHT &kp RET                        &kp PG_DN &kp RSHFT &kp RCTRL &kp RALT  &kp RGUI  &kp PSCRN
&trans  &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &kp LG(LS(S)) &kp C_PP &kp LC(W) &kp CAPS &trans   &trans    &trans    &trans    &trans
                  &tog 5    &trans    &trans    &trans        &trans   &trans  &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp LC(Y) LC(Z) &inc_dec_kp LC(PG_DN) LC(PG_UP)>;
        };

        sym_en_layer {
            display-name = "Sym_EN";
            bindings = <
&trans &trans    &trans    &trans    &trans    &trans                     &trans    &trans   &trans   &trans   &trans   &trans
&trans &kp GRAVE &kp DQT   &kp SEMI  &kp COLON &kp SQT                    &kp PLUS  &kp LBKT &kp RBKT &kp STAR &kp AMPS &kp CARET
&trans &kp EXCL  &kp QMARK &kp COMMA &kp DOT   &kp UNDER                  &kp EQUAL &kp LPAR &kp RPAR &kp FSLH &kp PIPE &kp BSLH
&trans &kp TILDE &kp AT    &kp HASH  &kp DLLR  &kp PRCNT &trans    &trans &kp MINUS &kp LBRC &kp RBRC &kp LT   &kp GT   &kp HASH
                 &trans    &trans    &trans    &trans    &trans    &trans &trans    &trans   &trans   &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        sym_ru_layer {
            display-name = "Sym_RU";
            bindings = <
&trans &trans        &trans     &trans       &trans       &trans                     &trans    &trans       &trans       &trans       &trans       &trans
&trans &en_sym GRAVE &kp LS(N2) &kp LS(N4)   &kp LS(N6)   &en_sym SQT                &kp PLUS  &en_sym LBKT &en_sym RBKT &kp STAR     &en_sym AMPS &en_sym CARET
&trans &kp EXCL      &kp LS(N7) &kp LS(FSLH) &kp FSLH     &kp UNDER                  &kp EQUAL &kp LPAR     &kp RPAR     &kp LS(BSLH) &en_sym PIPE &kp BSLH
&trans &en_sym TILDE &en_sym AT &en_sym HASH &en_sym DLLR &kp PRCNT &trans    &trans &kp MINUS &en_sym LBRC &en_sym RBRC &en_sym LT   &en_sym GT   &kp LS(N3)
                     &trans     &trans       &trans       &trans    &trans    &trans &trans    &trans       &trans       &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        numpad_layer {
            display-name = "Numpad";
            bindings = <
&tog 5    &kp KP_SLASH    &kp LPAR &kp RPAR &kp KP_NUM &kp MINUS                 &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &out OUT_TOG &trans &bt BT_CLR
&kp BSPC  &kp STAR        &kp N7   &kp N8   &kp N9     &kp PLUS                  &trans       &trans       &trans       &trans       &trans &trans
&kp TAB   &kp N0          &kp N4   &kp N5   &kp N6     &kp RET                   &trans       &trans       &trans       &trans       &trans &trans
&kp LCTRL &kp DOT         &kp N1   &kp N2   &kp N3     &kp EQUAL  &trans  &trans &trans       &trans       &trans       &trans       &trans &trans
                          &tog 5   &kp LALT &trans     &kp N0     &kp RET &trans &trans       &trans       &trans       &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp DOWN UP>;
        };
    };
};
