#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Хоткей смены языка в ОС: LA(LSHFT) = Alt+Shift, LG(SPACE) = Win+Space, LC(LSHFT) = Ctrl+Shift
#define LANG_SWITCH LA(LSHFT)

/ {
    macros {
        // Синхронное переключение языка: меняет язык в ОС и переключает внутренний флаг слоя 1 (RU)
        lang_sw: lang_sw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&macro_tap &kp LANG_SWITCH &tog 1>;
        };

        // Макрос для ввода отсутствующих в RU символов (скобки [], {}, <>, @, #, $, &, |, ~, `, ')
        en_sym: en_sym {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <20>;
            tap-ms = <15>;
            bindings
                = <&macro_tap &kp LANG_SWITCH>
                , <&macro_param_1to1>
                , <&macro_tap &kp MACRO_PLACEHOLDER>
                , <&macro_tap &kp LANG_SWITCH>
                ;
        };
    };

    behaviors {
        // Hold-Tap для Numpad: удержание включает слой временно (&mo), клик фиксирует слой (&tog)
        mo_tog: behavior_mo_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        // Если включен флаг RU (слой 1) и зажат слой символов (слой 3), автоматически включается SYM_RU (слой 4)
        ru_symbols_override {
            if-layers = <1 3>;
            then-layer = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Слой 0: Основной (EN)
        default_layer {
            display-name = "Default";
            bindings = <
&kp GRAVE &kp N1 &kp N2   &kp N3   &kp N4      &kp N5                           &kp N6  &kp N7   &kp N8    &kp N9  &kp N0   &kp MINUS
&kp ESC   &kp Q  &kp W    &kp E    &kp R       &kp T                            &kp Y   &kp U    &kp I     &kp O   &kp P    &kp LBKT
&kp TAB   &kp A  &kp S    &kp D    &kp F       &kp G                            &kp H   &kp J    &kp K     &kp L   &kp SEMI &kp SQT
&kp LCTRL &kp Z  &kp X    &kp C    &kp V       &kp B     &kp C_MUTE  &kp C_PP   &kp N   &kp M    &kp COMMA &kp DOT &kp FSLH &kp RBKT
                 &mo_tog 5 5 &kp LALT &mo 2    &kp SPACE &kp LSHFT   &kp RET    &kp BSPC &mo 3   &kp LGUI  &lang_sw
            >;

            // Левый: Громкость | Правый: Построчная прокрутка Вверх/Вниз
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp DOWN UP>;
        };

        // Слой 1: Маркер русского языка (RU State Flag)
        ru_layer {
            display-name = "RU_State";
            bindings = <
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans                  &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans &trans &trans
              &trans &trans &trans &trans &trans    &trans &trans &trans &trans &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp DOWN UP>;
        };

        // Слой 2: Навигация на ESDF + Enter/Язык слева | Модификаторы и Хоткеи справа
        lower_layer {
            display-name = "Lower";
            bindings = <
&kp F1  &kp F2    &kp F3    &kp F4    &kp F5    &kp F6                         &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12
&trans  &kp DEL   &kp HOME  &kp UP    &kp END   &lang_sw                       &kp PG_UP &kp LC(Y) &kp LC(A) &kp LC(F) &kp LC(S) &kp INS
&trans  &kp BSPC  &kp LEFT  &kp DOWN  &kp RIGHT &kp RET                        &kp PG_DN &kp RSHFT &kp RCTRL &kp RALT  &kp RGUI  &kp PSCRN
&trans  &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &kp LG(LS(S)) &kp C_PP &kp LC(W) &kp CAPS &trans   &trans    &trans    &trans    &trans
                  &tog 5    &trans    &trans    &trans        &trans   &trans  &trans    &trans    &trans    &tog 1
            >;

            // Левый: Отмена/Возврат (Ctrl+Y / Ctrl+Z) | Правый: Переключение вкладок (Ctrl+PgDn / Ctrl+PgUp)
            sensor-bindings = <&inc_dec_kp LC(Y) LC(Z) &inc_dec_kp LC(PG_DN) LC(PG_UP)>;
        };

        // Слой 3: Единый слой символов (Английский режим — вертикальные пары слева, скобки и математика справа)
        sym_en_layer {
            display-name = "Sym_EN";
            bindings = <
&trans &trans    &trans    &trans    &trans   &trans                     &trans       &trans   &trans   &trans          &trans   &trans
&trans &kp GRAVE &kp DQT   &kp SEMI  &kp COLON &kp SQT                   &kp KP_PLUS  &kp LBKT &kp RBKT &kp KP_MULTIPLY &kp AMPS &kp CARET
&trans &kp EXCL  &kp QMARK &kp COMMA &kp DOT  &kp UNDER                  &kp EQUAL    &kp LPAR &kp RPAR &kp KP_SLASH    &kp PIPE &kp BSLH
&trans &kp TILDE &kp AT    &kp HASH  &kp DLLR &kp PRCNT &trans    &trans &kp KP_MINUS &kp LBRC &kp RBRC &kp LT          &kp GT   &kp HASH
                 &trans    &trans    &trans   &trans    &trans    &trans &trans       &trans   &trans   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        // Слой 4: Единый слой символов (Русский режим — активируется автоматически поверх слоя 3)
        sym_ru_layer {
            display-name = "Sym_RU";
            bindings = <
&trans &trans         &trans     &trans       &trans      &trans                      &trans       &trans        &trans        &trans          &trans        &trans
&trans &en_sym GRAVE  &kp LS(N2) &kp LS(N4)   &kp LS(N6)  &en_sym SQT                 &kp KP_PLUS  &en_sym LBKT  &en_sym RBKT  &kp KP_MULTIPLY &en_sym AMPS  &en_sym CARET
&trans &kp EXCL       &kp LS(N7) &kp LS(FSLH) &kp FSLH    &kp UNDER                   &kp EQUAL    &kp LPAR      &kp RPAR      &kp KP_SLASH    &en_sym PIPE  &kp BSLH
&trans &en_sym TILDE  &en_sym AT &en_sym HASH &en_sym DLLR &kp PRCNT &trans    &trans &kp KP_MINUS &en_sym LBRC  &en_sym RBRC  &en_sym LT      &en_sym GT    &kp LS(N3)
                      &trans     &trans       &trans      &trans     &trans    &trans &trans       &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LC(RIGHT) LC(LEFT)>;
        };

        // Слой 5: Numpad слева + 3 профиля Bluetooth справа
        numpad_layer {
            display-name = "Numpad";
            bindings = <
&tog 5    &kp KP_SLASH    &kp N7  &kp N8  &kp N9  &kp KP_MINUS                    &trans       &trans       &trans       &trans     &trans       &trans
&kp BSPC  &kp KP_MULTIPLY &kp N7  &kp N8  &kp N9  &kp KP_PLUS                     &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR &out OUT_TOG &trans
&kp TAB   &kp N0          &kp N4  &kp N5  &kp N6  &kp RET                         &trans       &trans       &trans       &trans     &trans       &trans
&kp LCTRL &kp DOT         &kp N1  &kp N2  &kp N3  &kp EQUAL     &trans    &trans  &trans       &trans       &trans       &trans     &trans       &trans
                          &tog 5  &kp LALT &trans &kp N0        &kp RET   &trans  &trans       &trans       &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp DOWN UP>;
        };
    };
};
